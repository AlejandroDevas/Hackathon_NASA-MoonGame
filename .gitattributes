# Text files are stored with LF and checked out with LF on every system (git detects binaries by itself).
* text=auto eol=lf

# Binary assets that must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.wasm binary
*.woff2 binary
*.bin binary
*.tif binary
*.TIF binary
*.docx binary
